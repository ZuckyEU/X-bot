# Deployment environment: use "production" behind HTTPS, or "development" locally.
NODE_ENV=production

# Local/default port. Render overrides this with its dynamic PORT value.
# The server always binds to 0.0.0.0 so the platform can reach it.
PORT=10000

# Required in production: a unique random value of at least 32 characters.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Persistent data directory for user-db.json, auth.json, sessions/, and history.json.
# Defaults to the project directory. On Render/Docker, mount a persistent disk and
# point this at the mount path, for example /var/data.
# DATA_DIR=/var/data

# Optional: re-create an admin account on boot when DATA_DIR is empty, such as
# on a platform with an ephemeral filesystem. Set all three or leave all blank.
# The account is never modified if the username or email already exists.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# Required: Browserbase API key from https://www.browserbase.com/settings.
# Keep it out of source control. Browserbase can infer the project from the key.
BROWSERBASE_API_KEY=YOUR_API_KEY
# Recommended: pin the project explicitly instead of relying on inference.
BROWSERBASE_PROJECT_ID=YOUR_PROJECT_ID

# Optional: how long the interactive Browserbase debugger URL stays valid, in ms.
# Defaults to the 10-minute X login window; values below 30000 are ignored.
# BROWSERBASE_LIVE_TIMEOUT_MS=600000

# Optional: Browserbase session lifetime (default 900 seconds). The X login
# flow can take ten minutes, so do not lower this below the login window.
# BROWSERBASE_SESSION_TIMEOUT_SECONDS=900
# BROWSERBASE_SESSION_TIMEOUT_MS=900000

# Google Gen AI (Gemini) API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the model used by index.js and main.js
# gemini-2.5-flash is the recommended free-tier default.
GEMINI_MODEL=gemini-2.5-flash

# Optional bcrypt cost (allowed range: 10-15; default: 12)
BCRYPT_ROUNDS=12

# Optional: extra browser origins allowed to call the API (comma-separated).
# On Render, RENDER_EXTERNAL_URL is detected automatically and *.onrender.com is
# allowed in production. Set PUBLIC_ORIGIN for a custom domain.
# PUBLIC_ORIGIN=https://x-bot.example.com
# ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
