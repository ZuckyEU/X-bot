# Local standalone defaults. Copy this file to .env:
#   cp .env.example .env
NODE_ENV=development

# The dashboard is served at http://localhost:3000 by default.
PORT=3000

# Recommended, especially before exposing the app outside localhost. Use a
# unique random value of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local storage root. Accounts, Groq keys, and execution history are written to
# <DATA_DIR>/data/db.json. X sessions use <DATA_DIR>/sessions and the persistent
# Chromium profiles use <DATA_DIR>/user_data. Defaults to this project directory.
# DATA_DIR=C:\Users\you\X-bot-data

# Optional: use Supabase/PostgreSQL instead of the local JSON fallback. When set,
# accounts and X sessions live in PostgreSQL. The server creates its tables on
# boot. Use the pooler connection string from Supabase Project Settings → Database.
# DATABASE_URL=postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# Interactive "Connect X" opens a real Chromium window on this machine. Disable
# it on a headless server and use the advanced cookie import instead.
# INTERACTIVE_LOGIN_DISABLED=1
# How long the browser window waits for sign-in (30s–15min, default 5min).
# INTERACTIVE_LOGIN_TIMEOUT_MS=300000
# Set to 0 to ignore saved persistent profiles and fall back to storage-state
# restoration (useful for remote-only deployments).
# PERSISTENT_PROFILES=1

# Optional bootstrap account. Set all three or leave all blank.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# Chromium is installed locally by `npm run setup`:
#   npm run setup   # npm install && npx playwright install chromium

# Optional fallback Groq key. The dashboard normally stores one per app account.
# GROQ_API_KEY=gsk_...

# Optional Gemini demo key (index.js only; replies use Groq).
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-3.6-flash

# X session verification is enabled by default and required in production.
# Authenticated HTTP checks run first; local Chromium opens x.com/home when the
# API cannot confirm the cookies. Inconclusive checks are retryable 503s, not
# expired-session errors. X_SESSION_CHECK_DISABLED=1 is test/development only and
# is ignored in production.
# X_SESSION_CHECK_URL=https://api.x.com/1.1/account/settings.json,https://x.com/i/api/1.1/account/settings.json
# X_SESSION_CHECK_TIMEOUT_MS=3500
# X_SESSION_CHECK_BROWSER_TIMEOUT_MS=15000
# X_SESSION_CHECK_CACHE_MS=60000
# A failed run check retries once after this delay before returning 409/503.
# X_SESSION_CHECK_RETRY_MS=3000
# X_SESSION_CHECK_BEARER=public-web-bearer-override
X_SESSION_CHECK_DISABLED=0

# Optional bcrypt cost (allowed range: 10-15; default: 12)
BCRYPT_ROUNDS=12

# Optional extra browser origins allowed to call the API (comma-separated).
# PUBLIC_ORIGIN=https://x-bot.example.com
# ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
