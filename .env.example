# Deployment environment: use "production" behind HTTPS, or "development" locally.
NODE_ENV=production

# Local/default port. Render overrides this with its dynamic PORT value.
# The server always binds to 0.0.0.0 so the platform can reach it.
PORT=10000

# Required in production: a unique random value of at least 32 characters.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required in production: Supabase PostgreSQL connection string. The server
# creates the users and x_sessions tables automatically on boot. Use the
# pooler connection string from Project Settings -> Database.
DATABASE_URL=postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres
# Optional: set to false for a local/self-hosted database without TLS.
# DATABASE_SSL=true

# Runtime files: auth.json (staged X cookies), history.json, and trusted login
# profiles. User accounts and X sessions live in PostgreSQL. Defaults to the
# project directory; on Render, point DATA_DIR at a mounted disk if you want
# automation history to survive restarts.
# DATA_DIR=/var/data

# Optional: create an admin account on boot when it does not exist. Set all
# three or leave all blank. The account is never modified if the username or
# email already exists.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# Browsers run locally via Playwright; no remote browser API key is required.
# On Render, use the Docker runtime and the repository's Playwright image.
# On a local machine, install Chromium with: npx playwright install chromium

# Google Gen AI (Gemini) API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the model used by index.js and main.js
# gemini-2.5-flash is the recommended free-tier default.
GEMINI_MODEL=gemini-2.5-flash

# Optional: X session health check used by login/bootstrap and before live runs.
# The check is a lightweight authenticated request, not a browser launch, and
# is cached per cookie pair. Configured URLs run first, then api.x.com and x.com.
# Only HTTP 401 explicitly rejects a session; 404/network failures are "unknown".
# Unverified imports/runs return a retryable 503, not a session-expired error.
# Set X_SESSION_CHECK_DISABLED=1 only for offline environments ("unknown").
# X_SESSION_CHECK_URL=https://api.x.com/1.1/account/settings.json,https://x.com/i/api/1.1/account/settings.json
# X_SESSION_CHECK_TIMEOUT_MS=3500
# X_SESSION_CHECK_CACHE_MS=60000
# X_SESSION_CHECK_BEARER=public-web-bearer-override
# X_SESSION_CHECK_DISABLED=1

# Optional bcrypt cost (allowed range: 10-15; default: 12)
BCRYPT_ROUNDS=12

# Optional: extra browser origins allowed to call the API (comma-separated).
# On Render, RENDER_EXTERNAL_URL is detected automatically and *.onrender.com is
# allowed in production. Set PUBLIC_ORIGIN for a custom domain.
# PUBLIC_ORIGIN=https://x-bot.example.com
# ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
