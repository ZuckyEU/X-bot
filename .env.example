# Deployment environment: use "production" behind HTTPS, or "development" locally.
NODE_ENV=production

# Local server port. The server binds to 0.0.0.0 by default; set HOST=127.0.0.1
# if you want it reachable only from the local machine.
PORT=3000

# Required in production: a unique random value of at least 32 characters.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google Gen AI (Gemini) API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the model used by index.js and main.js
# gemini-2.5-flash is the recommended free-tier default.
GEMINI_MODEL=gemini-2.5-flash

# Optional bcrypt cost (allowed range: 10-15; default: 12)
BCRYPT_ROUNDS=12
